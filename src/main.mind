// main.mind - MIND-Ray CPU path tracer.
//
// A complete, runnable path tracer written in the executable subset of the
// MIND language that the released `mindc` 0.10.2 compiles to a native binary.
//
//   Scenes:     spheres | cornell | stress   (the presets of the pre-0.10
//               sources in archive/mind-pre-0.10/scene.mind; spheres adds a
//               small glass sphere to exercise the dielectric material)
//   Geometry:   spheres, horizontal ground planes, axis-aligned rectangles
//   Materials:  diffuse (Lambertian), metal (fuzzy reflection),
//               dielectric (refraction + Schlick), emissive (area lights)
//   RNG:        xorshift32, seeded per pixel from (x, y, seed)
//   Output:     binary PPM (P6) on stdout, FNV-1a 32-bit image hash on stderr
//
// Input is read from stdin as whitespace-separated fields:
//
//   <scene> <width> <height> <spp> <bounces> <seed>
//
//   echo "cornell 320 240 32 6 42" | ./target/debug/mind-ray > cornell.ppm
//
// Missing fields fall back to: spheres 320 180 16 4 42.
//
// WHY THE CODE IS SHAPED THIS WAY.  The released mindc 0.10.2 lowers f64
// scalars, i64 integers, while-loops and raw memory intrinsics, but not
// structs with float fields, `sqrt`, command-line arguments, or f64 values
// across a module boundary.  The renderer therefore:
//   - keeps vectors as three f64 locals instead of a Vec3 struct;
//   - stores the scene table as integer thousandths and decodes on load;
//   - computes square roots with a fixed-iteration Newton solve (det_sqrt);
//   - reads its configuration from stdin instead of argv;
//   - lives in one module.
// deferred: would split into vec3/ray/camera/material/scene modules with a
// Vec3 struct, stdlib sqrt and argv parsing, stubbed because mindc 0.10.2 does
// not lower float-field structs, `sqrt` or argv on the default backend, nor
// f64 across module boundaries — upgrade path: re-introduce the module split
// once those land in a released mindc; the pre-0.10 module sources are kept
// under archive/mind-pre-0.10/ as the reference layout.
//
// Every arithmetic step is plain IEEE-754 f64 add/sub/mul/div in a fixed
// source order with no transcendental calls, so the image hash printed on
// stderr is stable from run to run on the same toolchain.
//
// Author: STARGA Inc.
// License: MIT

// =============================================================================
// Constants
// =============================================================================

// One scene-table record holds this many i64 slots.
const REC: i64 = 16
// Maximum number of primitives in a scene.
const MAX_PRIMS: i64 = 80
// Scene values are stored as integer thousandths.
const MILLI: f64 = 1000.0
// xorshift32 state mask.
const MASK32: i64 = 4294967295

// Primitive kinds (slot 0).
const PRIM_SPHERE: i64 = 0
const PRIM_PLANE: i64 = 1
const PRIM_RECT: i64 = 2

// Material kinds (slot 1).
const MAT_DIFFUSE: i64 = 0
const MAT_METAL: i64 = 1
const MAT_DIELECTRIC: i64 = 2
const MAT_EMISSIVE: i64 = 3

// Scene ids.
const SCENE_SPHERES: i64 = 0
const SCENE_CORNELL: i64 = 1
const SCENE_STRESS: i64 = 2

// Scene header layout (slots before the primitive records):
//   0 primitive count
//   1..3   background rgb       (milli)
//   4..6   camera position      (milli)
//   7..9   camera look-at       (milli)
//   10     tan(vfov / 2)        (milli)
const HDR: i64 = 16

// =============================================================================
// Memory helpers (i64 slots)
// =============================================================================

fn slot_addr(base: i64, idx: i64) -> i64 {
    return base + idx * 8;
}

fn set_slot(base: i64, idx: i64, v: i64) -> i64 {
    __mind_store_i64(slot_addr(base, idx), v);
    return 0;
}

fn get_slot(base: i64, idx: i64) -> i64 {
    return __mind_load_i64(slot_addr(base, idx));
}

// Decode a slot stored in thousandths into f64.
fn get_milli(base: i64, idx: i64) -> f64 {
    return (get_slot(base, idx) as f64) / MILLI;
}

fn prim_base(scene: i64, i: i64) -> i64 {
    return slot_addr(scene, HDR + i * REC);
}

// =============================================================================
// Scalar math
// =============================================================================

fn absf(x: f64) -> f64 {
    if x < 0.0 {
        return 0.0 - x;
    }
    return x;
}

fn minf(a: f64, b: f64) -> f64 {
    if a < b {
        return a;
    }
    return b;
}

fn clamp01(x: f64) -> f64 {
    if x < 0.0 {
        return 0.0;
    }
    if x > 1.0 {
        return 1.0;
    }
    return x;
}

// Square root by range reduction to [0.25, 4) and a fixed 8-step Newton
// iteration. Fixed iteration count keeps the result independent of input.
fn det_sqrt(x: f64) -> f64 {
    if x <= 0.0 {
        return 0.0;
    }
    let mut m: f64 = x;
    let mut scale: f64 = 1.0;
    while m >= 4.0 {
        m = m * 0.25;
        scale = scale * 2.0;
    }
    while m < 0.25 {
        m = m * 4.0;
        scale = scale * 0.5;
    }
    let mut y: f64 = 0.5 * (m + 1.0);
    let mut i: i64 = 0;
    while i < 8 {
        y = 0.5 * (y + m / y);
        i = i + 1;
    }
    return y * scale;
}

fn dot3(ax: f64, ay: f64, az: f64, bx: f64, by: f64, bz: f64) -> f64 {
    return ax * bx + ay * by + az * bz;
}

fn len3(x: f64, y: f64, z: f64) -> f64 {
    return det_sqrt(dot3(x, y, z, x, y, z));
}

// Schlick's approximation for dielectric reflectance.
fn schlick(cosine: f64, ref_idx: f64) -> f64 {
    let r: f64 = (1.0 - ref_idx) / (1.0 + ref_idx);
    let r0: f64 = r * r;
    let c: f64 = 1.0 - cosine;
    return r0 + (1.0 - r0) * (c * c * c * c * c);
}

// =============================================================================
// RNG: xorshift32, state kept in one i64 slot
// =============================================================================

fn rng_next(rng: i64) -> i64 {
    let mut x: i64 = __mind_load_i64(rng);
    x = x ^ ((x << 13) & MASK32);
    x = x ^ (x >> 17);
    x = x ^ ((x << 5) & MASK32);
    __mind_store_i64(rng, x);
    return x;
}

// Uniform f64 in [0, 1) with 24 bits of resolution.
fn rng_f64(rng: i64) -> f64 {
    return ((rng_next(rng) >> 8) as f64) / 16777216.0;
}

// Seed the per-pixel stream from (x, y, seed); never zero.
fn rng_seed(rng: i64, x: i64, y: i64, seed: i64) -> i64 {
    let mut s: i64 = (seed * 1973 + x * 9277 + y * 26699) & MASK32;
    s = s | 1;
    __mind_store_i64(rng, s);
    rng_next(rng);
    rng_next(rng);
    return 0;
}

// Random point inside the unit sphere (rejection sampling). The three
// coordinates are written to v[0..2] as integers in units of 2^-24, which
// keeps them exact in i64 slots.
fn rng_in_sphere(rng: i64, v: i64) -> i64 {
    let mut done: i64 = 0;
    while done == 0 {
        let a: i64 = (rng_next(rng) >> 8) * 2 - 16777216;
        let b: i64 = (rng_next(rng) >> 8) * 2 - 16777216;
        let c: i64 = (rng_next(rng) >> 8) * 2 - 16777216;
        let fa: f64 = (a as f64) / 16777216.0;
        let fb: f64 = (b as f64) / 16777216.0;
        let fc: f64 = (c as f64) / 16777216.0;
        if dot3(fa, fb, fc, fa, fb, fc) < 1.0 {
            set_slot(v, 0, a);
            set_slot(v, 1, b);
            set_slot(v, 2, c);
            done = 1;
        }
    }
    return 0;
}

fn rand_comp(v: i64, i: i64) -> f64 {
    return (get_slot(v, i) as f64) / 16777216.0;
}

// =============================================================================
// Scene construction
// =============================================================================

fn set_material(p: i64, kind: i64, r: i64, g: i64, b: i64, param: i64) -> i64 {
    set_slot(p, 1, kind);
    set_slot(p, 2, r);
    set_slot(p, 3, g);
    set_slot(p, 4, b);
    set_slot(p, 5, param);
    return 0;
}

fn add_sphere(scene: i64, cx: i64, cy: i64, cz: i64, rad: i64) -> i64 {
    let n: i64 = get_slot(scene, 0);
    let p: i64 = prim_base(scene, n);
    set_slot(p, 0, PRIM_SPHERE);
    set_slot(p, 9, cx);
    set_slot(p, 10, cy);
    set_slot(p, 11, cz);
    set_slot(p, 12, rad);
    set_slot(scene, 0, n + 1);
    return p;
}

fn add_plane_y(scene: i64, k: i64) -> i64 {
    let n: i64 = get_slot(scene, 0);
    let p: i64 = prim_base(scene, n);
    set_slot(p, 0, PRIM_PLANE);
    set_slot(p, 9, k);
    set_slot(scene, 0, n + 1);
    return p;
}

// Axis-aligned rectangle. axis 0: x = k, spans (y in a0..a1, z in b0..b1);
// axis 1: y = k, spans (x, z); axis 2: z = k, spans (x, y).
fn add_rect(scene: i64, axis: i64, a0: i64, a1: i64, b0: i64, b1: i64, k: i64) -> i64 {
    let n: i64 = get_slot(scene, 0);
    let p: i64 = prim_base(scene, n);
    set_slot(p, 0, PRIM_RECT);
    set_slot(p, 9, axis);
    set_slot(p, 10, a0);
    set_slot(p, 11, a1);
    set_slot(p, 12, b0);
    set_slot(p, 13, b1);
    set_slot(p, 14, k);
    set_slot(scene, 0, n + 1);
    return p;
}

fn set_camera(scene: i64, px: i64, py: i64, pz: i64, lx: i64, ly: i64, lz: i64, tan_half: i64) -> i64 {
    set_slot(scene, 4, px);
    set_slot(scene, 5, py);
    set_slot(scene, 6, pz);
    set_slot(scene, 7, lx);
    set_slot(scene, 8, ly);
    set_slot(scene, 9, lz);
    set_slot(scene, 10, tan_half);
    return 0;
}

fn set_background(scene: i64, r: i64, g: i64, b: i64) -> i64 {
    set_slot(scene, 1, r);
    set_slot(scene, 2, g);
    set_slot(scene, 3, b);
    return 0;
}

// Three spheres on a ground plane under a sky-coloured background.
fn build_spheres(scene: i64) -> i64 {
    set_material(add_sphere(scene, 0, 1000, 0 - 3500, 1000), MAT_DIFFUSE, 800, 300, 200, 0);
    set_material(add_sphere(scene, 0 - 1800, 900, 0 - 2400, 900), MAT_DIFFUSE, 200, 700, 900, 0);
    set_material(add_sphere(scene, 1700, 800, 0 - 2000, 800), MAT_METAL, 900, 850, 700, 150);
    set_material(add_sphere(scene, 450, 350, 0 - 1500, 350), MAT_DIELECTRIC, 1000, 1000, 1000, 1500);
    set_material(add_plane_y(scene, 0), MAT_DIFFUSE, 500, 500, 500, 0);
    set_background(scene, 600, 750, 950);
    // tan(55 deg / 2) = 0.5206
    set_camera(scene, 0, 1200, 1200, 0, 900, 0 - 2800, 521);
    return 0;
}

// Cornell box: coloured walls, a ceiling area light, a diffuse and a metal
// sphere, black background.
fn build_cornell(scene: i64) -> i64 {
    set_material(add_rect(scene, 1, 0 - 2500, 2500, 0 - 2500, 2500, 0), MAT_DIFFUSE, 730, 730, 730, 0);
    set_material(add_rect(scene, 1, 0 - 2500, 2500, 0 - 2500, 2500, 5000), MAT_DIFFUSE, 730, 730, 730, 0);
    set_material(add_rect(scene, 2, 0 - 2500, 2500, 0, 5000, 0 - 2500), MAT_DIFFUSE, 730, 730, 730, 0);
    set_material(add_rect(scene, 0, 0, 5000, 0 - 2500, 2500, 0 - 2500), MAT_DIFFUSE, 650, 50, 50, 0);
    set_material(add_rect(scene, 0, 0, 5000, 0 - 2500, 2500, 2500), MAT_DIFFUSE, 120, 450, 150, 0);
    set_material(add_rect(scene, 1, 0 - 1000, 1000, 0 - 1000, 1000, 4990), MAT_EMISSIVE, 15000, 15000, 15000, 0);
    set_material(add_sphere(scene, 0 - 1000, 700, 0 - 1000, 700), MAT_DIFFUSE, 730, 730, 730, 0);
    set_material(add_sphere(scene, 1200, 500, 500, 500), MAT_METAL, 900, 900, 900, 50);
    set_background(scene, 0, 0, 0);
    // tan(40 deg / 2) = 0.3640
    set_camera(scene, 0, 2500, 10000, 0, 2500, 0, 364);
    return 0;
}

// 8x8 grid of small spheres (metal + three diffuse colours) on a ground plane.
fn build_stress(scene: i64) -> i64 {
    set_material(add_plane_y(scene, 0), MAT_DIFFUSE, 500, 500, 500, 0);
    let mut i: i64 = 0;
    while i < 8 {
        let mut j: i64 = 0;
        while j < 8 {
            let x: i64 = 0 - 8000 + i * 2000 + 500;
            let z: i64 = 0 - 8000 + j * 2000 + 500;
            let p: i64 = add_sphere(scene, x, 300, z, 300);
            let m: i64 = (i + j) % 4;
            if m == 0 {
                set_material(p, MAT_METAL, 800, 800, 800, 300)
            }
            if m == 1 {
                set_material(p, MAT_DIFFUSE, 800, 400, 400, 0)
            }
            if m == 2 {
                set_material(p, MAT_DIFFUSE, 400, 800, 400, 0)
            }
            if m == 3 {
                set_material(p, MAT_DIFFUSE, 400, 400, 800, 0)
            }
            j = j + 1;
        }
        i = i + 1;
    }
    set_background(scene, 500, 600, 700);
    // tan(50 deg / 2) = 0.4663
    set_camera(scene, 0, 3000, 12000, 0, 1000, 0, 466);
    return 0;
}

fn build_scene(scene: i64, id: i64) -> i64 {
    set_slot(scene, 0, 0);
    if id == SCENE_CORNELL {
        return build_cornell(scene);
    }
    if id == SCENE_STRESS {
        return build_stress(scene);
    }
    return build_spheres(scene);
}

// =============================================================================
// Intersection
// =============================================================================

// Ray-sphere: nearest root in (tmin, tmax), or -1.
fn hit_sphere(p: i64, ox: f64, oy: f64, oz: f64, dx: f64, dy: f64, dz: f64, tmin: f64, tmax: f64) -> f64 {
    let cx: f64 = get_milli(p, 9);
    let cy: f64 = get_milli(p, 10);
    let cz: f64 = get_milli(p, 11);
    let r: f64 = get_milli(p, 12);
    let ocx: f64 = ox - cx;
    let ocy: f64 = oy - cy;
    let ocz: f64 = oz - cz;
    let a: f64 = dot3(dx, dy, dz, dx, dy, dz);
    let hb: f64 = dot3(ocx, ocy, ocz, dx, dy, dz);
    let c: f64 = dot3(ocx, ocy, ocz, ocx, ocy, ocz) - r * r;
    let disc: f64 = hb * hb - a * c;
    if disc < 0.0 {
        return 0.0 - 1.0;
    }
    let sq: f64 = det_sqrt(disc);
    let t0: f64 = (0.0 - hb - sq) / a;
    if t0 > tmin {
        if t0 < tmax {
            return t0;
        }
    }
    let t1: f64 = (0.0 - hb + sq) / a;
    if t1 > tmin {
        if t1 < tmax {
            return t1;
        }
    }
    return 0.0 - 1.0;
}

// Ray against the horizontal plane y = k.
fn hit_plane(p: i64, oy: f64, dy: f64, tmin: f64, tmax: f64) -> f64 {
    if absf(dy) < 0.000001 {
        return 0.0 - 1.0;
    }
    let t: f64 = (get_milli(p, 9) - oy) / dy;
    if t > tmin {
        if t < tmax {
            return t;
        }
    }
    return 0.0 - 1.0;
}

// Ray against an axis-aligned rectangle (see add_rect for the axis layout).
fn hit_rect(p: i64, ox: f64, oy: f64, oz: f64, dx: f64, dy: f64, dz: f64, tmin: f64, tmax: f64) -> f64 {
    let axis: i64 = get_slot(p, 9);
    let k: f64 = get_milli(p, 14);
    let mut on: f64 = ox;
    let mut dn: f64 = dx;
    let mut oa: f64 = oy;
    let mut da: f64 = dy;
    let mut ob: f64 = oz;
    let mut db: f64 = dz;
    if axis == 1 {
        on = oy;
        dn = dy;
        oa = ox;
        da = dx;
        ob = oz;
        db = dz;
    }
    if axis == 2 {
        on = oz;
        dn = dz;
        oa = ox;
        da = dx;
        ob = oy;
        db = dy;
    }
    if absf(dn) < 0.000001 {
        return 0.0 - 1.0;
    }
    let t: f64 = (k - on) / dn;
    if t <= tmin {
        return 0.0 - 1.0;
    }
    if t >= tmax {
        return 0.0 - 1.0;
    }
    let a: f64 = oa + t * da;
    let b: f64 = ob + t * db;
    if a < get_milli(p, 10) {
        return 0.0 - 1.0;
    }
    if a > get_milli(p, 11) {
        return 0.0 - 1.0;
    }
    if b < get_milli(p, 12) {
        return 0.0 - 1.0;
    }
    if b > get_milli(p, 13) {
        return 0.0 - 1.0;
    }
    return t;
}

// Closest hit over the whole scene. Returns t (or -1) and writes the index of
// the primitive that was hit into the `hit_idx` slot.
fn scene_hit(scene: i64, hit_idx: i64, ox: f64, oy: f64, oz: f64, dx: f64, dy: f64, dz: f64) -> f64 {
    let n: i64 = get_slot(scene, 0);
    let mut best: f64 = 1000000.0;
    let mut found: i64 = 0 - 1;
    let mut i: i64 = 0;
    while i < n {
        let p: i64 = prim_base(scene, i);
        let kind: i64 = get_slot(p, 0);
        let mut t: f64 = 0.0 - 1.0;
        if kind == PRIM_SPHERE {
            t = hit_sphere(p, ox, oy, oz, dx, dy, dz, 0.001, best);
        }
        if kind == PRIM_PLANE {
            t = hit_plane(p, oy, dy, 0.001, best);
        }
        if kind == PRIM_RECT {
            t = hit_rect(p, ox, oy, oz, dx, dy, dz, 0.001, best);
        }
        if t > 0.0 {
            best = t;
            found = i;
        }
        i = i + 1;
    }
    set_slot(hit_idx, 0, found);
    if found < 0 {
        return 0.0 - 1.0;
    }
    return best;
}

// =============================================================================
// Path tracing
// =============================================================================

// Trace one camera path. Radiance is accumulated (in units of 2^-24) into the
// three slots acc[0..2]. `work` provides scratch slots: [0] hit index,
// [1..3] random vector, [4] rng state.
fn trace_path(scene: i64, work: i64, acc: i64, ox0: f64, oy0: f64, oz0: f64, dx0: f64, dy0: f64, dz0: f64, bounces: i64) -> i64 {
    let rng: i64 = slot_addr(work, 4);
    let rv: i64 = slot_addr(work, 1);
    let mut ox: f64 = ox0;
    let mut oy: f64 = oy0;
    let mut oz: f64 = oz0;
    let mut dx: f64 = dx0;
    let mut dy: f64 = dy0;
    let mut dz: f64 = dz0;
    let mut tr: f64 = 1.0;
    let mut tg: f64 = 1.0;
    let mut tb: f64 = 1.0;
    let mut lr: f64 = 0.0;
    let mut lg: f64 = 0.0;
    let mut lb: f64 = 0.0;
    let mut depth: i64 = 0;
    let mut alive: i64 = 1;
    while alive == 1 {
        let t: f64 = scene_hit(scene, work, ox, oy, oz, dx, dy, dz);
        if t < 0.0 {
            lr = lr + tr * get_milli(scene, 1);
            lg = lg + tg * get_milli(scene, 2);
            lb = lb + tb * get_milli(scene, 3);
            alive = 0;
        } else {
            let p: i64 = prim_base(scene, get_slot(work, 0));
            let kind: i64 = get_slot(p, 0);
            let mat: i64 = get_slot(p, 1);
            let hx: f64 = ox + t * dx;
            let hy: f64 = oy + t * dy;
            let hz: f64 = oz + t * dz;
            // Geometric outward normal.
            let mut nx: f64 = 0.0;
            let mut ny: f64 = 1.0;
            let mut nz: f64 = 0.0;
            if kind == PRIM_SPHERE {
                let rad: f64 = get_milli(p, 12);
                nx = (hx - get_milli(p, 9)) / rad;
                ny = (hy - get_milli(p, 10)) / rad;
                nz = (hz - get_milli(p, 11)) / rad;
            }
            if kind == PRIM_RECT {
                let axis: i64 = get_slot(p, 9);
                ny = 0.0;
                if axis == 0 {
                    nx = 1.0;
                }
                if axis == 1 {
                    ny = 1.0;
                }
                if axis == 2 {
                    nz = 1.0;
                }
            }
            // Face the normal against the incoming ray.
            let mut front: i64 = 1;
            if dot3(dx, dy, dz, nx, ny, nz) > 0.0 {
                nx = 0.0 - nx;
                ny = 0.0 - ny;
                nz = 0.0 - nz;
                front = 0;
            }
            let ar: f64 = get_milli(p, 2);
            let ag: f64 = get_milli(p, 3);
            let ab: f64 = get_milli(p, 4);
            let param: f64 = get_milli(p, 5);
            if mat == MAT_EMISSIVE {
                lr = lr + tr * ar;
                lg = lg + tg * ag;
                lb = lb + tb * ab;
                alive = 0;
            } else {
                let dl: f64 = len3(dx, dy, dz);
                let ux: f64 = dx / dl;
                let uy: f64 = dy / dl;
                let uz: f64 = dz / dl;
                let mut sx: f64 = 0.0;
                let mut sy: f64 = 0.0;
                let mut sz: f64 = 0.0;
                if mat == MAT_DIFFUSE {
                    rng_in_sphere(rng, rv);
                    sx = nx + rand_comp(rv, 0);
                    sy = ny + rand_comp(rv, 1);
                    sz = nz + rand_comp(rv, 2);
                    if dot3(sx, sy, sz, sx, sy, sz) < 0.00000001 {
                        sx = nx;
                        sy = ny;
                        sz = nz;
                    }
                }
                if mat == MAT_METAL {
                    let dn: f64 = dot3(ux, uy, uz, nx, ny, nz);
                    rng_in_sphere(rng, rv);
                    sx = ux - 2.0 * dn * nx + param * rand_comp(rv, 0);
                    sy = uy - 2.0 * dn * ny + param * rand_comp(rv, 1);
                    sz = uz - 2.0 * dn * nz + param * rand_comp(rv, 2);
                    if dot3(sx, sy, sz, nx, ny, nz) <= 0.0 {
                        alive = 0;
                    }
                }
                if mat == MAT_DIELECTRIC {
                    let mut eta: f64 = param;
                    if front == 1 {
                        eta = 1.0 / param;
                    }
                    let cos_t: f64 = minf(0.0 - dot3(ux, uy, uz, nx, ny, nz), 1.0);
                    let sin2: f64 = 1.0 - cos_t * cos_t;
                    let reflect_p: f64 = schlick(cos_t, eta);
                    if eta * eta * sin2 > 1.0 || rng_f64(rng) < reflect_p {
                        let dn2: f64 = dot3(ux, uy, uz, nx, ny, nz);
                        sx = ux - 2.0 * dn2 * nx;
                        sy = uy - 2.0 * dn2 * ny;
                        sz = uz - 2.0 * dn2 * nz;
                    } else {
                        let px: f64 = eta * (ux + cos_t * nx);
                        let py: f64 = eta * (uy + cos_t * ny);
                        let pz: f64 = eta * (uz + cos_t * nz);
                        let par: f64 = 0.0 - det_sqrt(absf(1.0 - dot3(px, py, pz, px, py, pz)));
                        sx = px + par * nx;
                        sy = py + par * ny;
                        sz = pz + par * nz;
                    }
                }
                tr = tr * ar;
                tg = tg * ag;
                tb = tb * ab;
                ox = hx;
                oy = hy;
                oz = hz;
                dx = sx;
                dy = sy;
                dz = sz;
                depth = depth + 1;
                if depth >= bounces {
                    alive = 0;
                }
            }
        }
    }
    set_slot(acc, 0, get_slot(acc, 0) + ((lr * 16777216.0) as i64));
    set_slot(acc, 1, get_slot(acc, 1) + ((lg * 16777216.0) as i64));
    set_slot(acc, 2, get_slot(acc, 2) + ((lb * 16777216.0) as i64));
    return 0;
}

// Linear radiance -> 8-bit sRGB-ish (gamma 2) byte.
fn to_byte(sum: i64, spp: i64) -> i64 {
    let v: f64 = ((sum as f64) / 16777216.0) / (spp as f64);
    let g: f64 = det_sqrt(clamp01(v));
    let b: i64 = (g * 255.999) as i64;
    if b > 255 {
        return 255;
    }
    return b;
}

// Render the whole image into `img` (w*h*3 bytes, top row first).
fn render(scene: i64, img: i64, w: i64, h: i64, spp: i64, bounces: i64, seed: i64) -> i64 {
    let work: i64 = __mind_alloc(8 * 8);
    let acc: i64 = __mind_alloc(4 * 8);
    let rng: i64 = slot_addr(work, 4);
    // Camera basis from the scene header (look-at, world up = +y).
    let cx: f64 = get_milli(scene, 4);
    let cy: f64 = get_milli(scene, 5);
    let cz: f64 = get_milli(scene, 6);
    let wx0: f64 = cx - get_milli(scene, 7);
    let wy0: f64 = cy - get_milli(scene, 8);
    let wz0: f64 = cz - get_milli(scene, 9);
    let wl: f64 = len3(wx0, wy0, wz0);
    let wx: f64 = wx0 / wl;
    let wy: f64 = wy0 / wl;
    let wz: f64 = wz0 / wl;
    // u = normalize(up x w), up = (0, 1, 0)
    let ux0: f64 = wz;
    let uz0: f64 = 0.0 - wx;
    let ul: f64 = len3(ux0, 0.0, uz0);
    let ux: f64 = ux0 / ul;
    let uz: f64 = uz0 / ul;
    // v = w x u
    let vx: f64 = wy * uz;
    let vy: f64 = wz * ux - wx * uz;
    let vz: f64 = 0.0 - wy * ux;
    let half_h: f64 = get_milli(scene, 10);
    let half_w: f64 = half_h * ((w as f64) / (h as f64));
    let mut y: i64 = 0;
    while y < h {
        let mut x: i64 = 0;
        while x < w {
            rng_seed(rng, x, y, seed);
            set_slot(acc, 0, 0);
            set_slot(acc, 1, 0);
            set_slot(acc, 2, 0);
            let mut s: i64 = 0;
            while s < spp {
                let su: f64 = ((x as f64) + rng_f64(rng)) / (w as f64);
                let sv: f64 = (((h - 1 - y) as f64) + rng_f64(rng)) / (h as f64);
                let a: f64 = (2.0 * su - 1.0) * half_w;
                let b: f64 = (2.0 * sv - 1.0) * half_h;
                let dx: f64 = a * ux + b * vx - wx;
                let dy: f64 = b * vy - wy;
                let dz: f64 = a * uz + b * vz - wz;
                trace_path(scene, work, acc, cx, cy, cz, dx, dy, dz, bounces);
                s = s + 1;
            }
            let o: i64 = img + (y * w + x) * 3;
            __mind_store_i8(o, to_byte(get_slot(acc, 0), spp));
            __mind_store_i8(o + 1, to_byte(get_slot(acc, 1), spp));
            __mind_store_i8(o + 2, to_byte(get_slot(acc, 2), spp));
            x = x + 1;
        }
        y = y + 1;
    }
    return 0;
}

// =============================================================================
// Input / output
// =============================================================================

fn is_space(c: i64) -> i64 {
    if c == 32 || c == 9 || c == 10 || c == 13 {
        return 1;
    }
    return 0;
}

// Index of the start of the next token at or after `pos` (or `len`).
fn skip_space(buf: i64, len: i64, pos: i64) -> i64 {
    let mut p: i64 = pos;
    while p < len && is_space(__mind_load_i8(buf + p)) == 1 {
        p = p + 1;
    }
    return p;
}

fn token_end(buf: i64, len: i64, pos: i64) -> i64 {
    let mut p: i64 = pos;
    while p < len && is_space(__mind_load_i8(buf + p)) == 0 {
        p = p + 1;
    }
    return p;
}

// Parse a non-negative decimal integer in [start, end), or `fallback` if the
// token is empty, contains a non-digit or is out of range.
fn parse_int(buf: i64, start: i64, end: i64, fallback: i64) -> i64 {
    if start >= end {
        return fallback;
    }
    let mut v: i64 = 0;
    let mut p: i64 = start;
    while p < end {
        let c: i64 = __mind_load_i8(buf + p);
        if c < 48 || c > 57 {
            return fallback;
        }
        v = v * 10 + (c - 48);
        if v > 1000000000 {
            return fallback;
        }
        p = p + 1;
    }
    return v;
}

// Scene name -> id: "cornell" -> 1, "stress" -> 2, anything else -> spheres.
fn parse_scene(buf: i64, start: i64, end: i64) -> i64 {
    if end - start < 2 {
        return SCENE_SPHERES;
    }
    let c0: i64 = __mind_load_i8(buf + start);
    let c1: i64 = __mind_load_i8(buf + start + 1);
    if c0 == 99 {
        return SCENE_CORNELL;
    }
    if c0 == 115 && c1 == 116 {
        return SCENE_STRESS;
    }
    return SCENE_SPHERES;
}

fn clamp_int(v: i64, lo: i64, hi: i64) -> i64 {
    if v < lo {
        return lo;
    }
    if v > hi {
        return hi;
    }
    return v;
}

// Write `v` in decimal at buf+pos; returns the new position.
fn put_uint(buf: i64, pos: i64, v: i64) -> i64 {
    let mut div: i64 = 1;
    while div * 10 <= v {
        div = div * 10;
    }
    let mut p: i64 = pos;
    while div > 0 {
        __mind_store_i8(buf + p, 48 + (v / div) % 10);
        p = p + 1;
        div = div / 10;
    }
    return p;
}

// Write n bytes to fd, retrying on short writes. Returns 0 or -1 on error.
fn write_all(fd: i64, buf: i64, n: i64) -> i64 {
    let mut done: i64 = 0;
    while done < n {
        let k: i64 = __mind_write(fd, buf + done, n - done, 0 - 1);
        if k <= 0 {
            return 0 - 1;
        }
        done = done + k;
    }
    return 0;
}

fn put_byte(buf: i64, pos: i64, c: i64) -> i64 {
    __mind_store_i8(buf + pos, c);
    return pos + 1;
}

fn hex_digit(d: i64) -> i64 {
    if d < 10 {
        return 48 + d;
    }
    return 87 + d;
}

// FNV-1a 32-bit over n bytes.
fn fnv1a32(buf: i64, n: i64) -> i64 {
    let mut h: i64 = 2166136261;
    let mut i: i64 = 0;
    while i < n {
        h = ((h ^ __mind_load_i8(buf + i)) * 16777619) & MASK32;
        i = i + 1;
    }
    return h;
}

// stderr line: "mind-ray: <w>x<h> spp=<spp> fnv1a32=<8 hex digits>"
fn report_hash(w: i64, h: i64, spp: i64, hash: i64) -> i64 {
    let buf: i64 = __mind_alloc(128);
    let mut p: i64 = 0;
    // "mind-ray: "
    p = put_byte(buf, p, 109);
    p = put_byte(buf, p, 105);
    p = put_byte(buf, p, 110);
    p = put_byte(buf, p, 100);
    p = put_byte(buf, p, 45);
    p = put_byte(buf, p, 114);
    p = put_byte(buf, p, 97);
    p = put_byte(buf, p, 121);
    p = put_byte(buf, p, 58);
    p = put_byte(buf, p, 32);
    p = put_uint(buf, p, w);
    p = put_byte(buf, p, 120);
    p = put_uint(buf, p, h);
    // " spp="
    p = put_byte(buf, p, 32);
    p = put_byte(buf, p, 115);
    p = put_byte(buf, p, 112);
    p = put_byte(buf, p, 112);
    p = put_byte(buf, p, 61);
    p = put_uint(buf, p, spp);
    // " fnv1a32="
    p = put_byte(buf, p, 32);
    p = put_byte(buf, p, 102);
    p = put_byte(buf, p, 110);
    p = put_byte(buf, p, 118);
    p = put_byte(buf, p, 49);
    p = put_byte(buf, p, 97);
    p = put_byte(buf, p, 51);
    p = put_byte(buf, p, 50);
    p = put_byte(buf, p, 61);
    let mut shift: i64 = 28;
    while shift >= 0 {
        p = put_byte(buf, p, hex_digit((hash >> shift) & 15));
        shift = shift - 4;
    }
    p = put_byte(buf, p, 10);
    __mind_write(2, buf, p, 0 - 1);
    return 0;
}

// =============================================================================
// Entry point
// =============================================================================

fn main() -> i64 {
    // Read the configuration line from stdin.
    let inbuf: i64 = __mind_alloc(256);
    let mut len: i64 = __mind_read(0, inbuf, 255, 0 - 1);
    if len < 0 {
        len = 0;
    }
    let s0: i64 = skip_space(inbuf, len, 0);
    let e0: i64 = token_end(inbuf, len, s0);
    let s1: i64 = skip_space(inbuf, len, e0);
    let e1: i64 = token_end(inbuf, len, s1);
    let s2: i64 = skip_space(inbuf, len, e1);
    let e2: i64 = token_end(inbuf, len, s2);
    let s3: i64 = skip_space(inbuf, len, e2);
    let e3: i64 = token_end(inbuf, len, s3);
    let s4: i64 = skip_space(inbuf, len, e3);
    let e4: i64 = token_end(inbuf, len, s4);
    let s5: i64 = skip_space(inbuf, len, e4);
    let e5: i64 = token_end(inbuf, len, s5);
    let scene_id: i64 = parse_scene(inbuf, s0, e0);
    let w: i64 = clamp_int(parse_int(inbuf, s1, e1, 320), 1, 4096);
    let h: i64 = clamp_int(parse_int(inbuf, s2, e2, 180), 1, 4096);
    let spp: i64 = clamp_int(parse_int(inbuf, s3, e3, 16), 1, 65536);
    let bounces: i64 = clamp_int(parse_int(inbuf, s4, e4, 4), 1, 64);
    let seed: i64 = parse_int(inbuf, s5, e5, 42);

    let scene: i64 = __mind_alloc((HDR + MAX_PRIMS * REC) * 8);
    build_scene(scene, scene_id);

    let npix: i64 = w * h * 3;
    let img: i64 = __mind_alloc(npix);
    render(scene, img, w, h, spp, bounces, seed);

    // PPM header: "P6\n<w> <h>\n255\n"
    let hdr: i64 = __mind_alloc(64);
    let mut p: i64 = 0;
    p = put_byte(hdr, p, 80);
    p = put_byte(hdr, p, 54);
    p = put_byte(hdr, p, 10);
    p = put_uint(hdr, p, w);
    p = put_byte(hdr, p, 32);
    p = put_uint(hdr, p, h);
    p = put_byte(hdr, p, 10);
    p = put_uint(hdr, p, 255);
    p = put_byte(hdr, p, 10);
    if write_all(1, hdr, p) != 0 {
        return 1;
    }
    if write_all(1, img, npix) != 0 {
        return 1;
    }

    report_hash(w, h, spp, fnv1a32(img, npix));
    return 0;
}
